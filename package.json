{
  "name": "txt-notes",
  "version": "0.4.1",
  "description": "A no frills note taking app that works with txt files.",
  "main": "main.js",
  "desktopName": "txt-notes.desktop",
  "author": "Troy Coutu",
  "license": "CC0-1.0",
  "dependencies": {
    "electron-context-menu": "5.1.0",
    "electron-window-state": "5.0.3",
    "split-grid": "1.0.11",
    "teddy": "2.3.3"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-reloader": "1.2.3",
    "standard": "17.1.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "scripts": {
    "start": "electron .",
    "build": "node build/build.js",
    "build-self": "node build/build.js self",
    "build-lin": "node build/build.js linux",
    "build-mac": "node build/build.js mac",
    "build-win": "node build/build.js win",
    "unpack-mac": "rm -rf asar-unpack && asar extract dist/mac/*.app/Contents/Resources/app.asar ./asar-unpack",
    "lint": "standard && stylelint *.css",
    "lint-fix": "standard --fix && stylelint *.css --fix",
    "test": "npm run lint && playwright test"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
